# =============================================================================
# Plantilla d'entorn (no commitjar aquest fitxer amb valors reals).
# Copia'l a .env i omple els valors. Tots els secrets vénen de fora del repo.
# =============================================================================

# --- Entorn i base de dades ---
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Data Source=/app/data/collagegantera.db
# També acceptada: DATABASE_CONNECTION=

# --- JWT ---
# Clau per signar i validar tokens. Mínim 32 caràcters. Sense fallback.
JWT_KEY=

# --- Colla ---
# Codi que els usuaris han de posar al registrar-se.
COLLA_CODE=

# Admin superusuari opcional (per al seeding de rols).
ADMIN_EMAIL=

# --- SMTP (Gmail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_NAME=Colla Gegantera

# --- Web Push / VAPID ---
# Genera-les localment amb: npx web-push generate-vapid-keys
# (la pública també pot anar a appsettings.json; aquestes dues han de coincidir)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:colla@gegantera.app

# --- Frontend (NOMÉS variables VITE_ = públiques; no hi pot anar cap secret) ---
VITE_API_URL=